syntax = "v1"

import "../base/base.api"

type (
	AdminOperationLogListReq {
		PageQueryReq
		AdminId   *int64  `form:"admin_id,optional" validate:"omitempty,gt=0"`
		Username  *string `form:"username,optional" validate:"omitempty,max=64"`
		Action    *string `form:"action,optional" validate:"omitempty,max=128"`
		Status    *int32  `form:"status,optional" validate:"omitempty,oneof=1 2"` // 结果 1成功 2失败
		StartTime *int64  `form:"start_time,optional" validate:"omitempty,gt=0"`
		EndTime   *int64  `form:"end_time,optional" validate:"omitempty,gt=0"`
	}
	AdminOperationLogItem {
		Id        int64     `json:"id"`
		AdminId   int64     `json:"admin_id"`
		Username  string    `json:"username"`
		Action    string    `json:"action"`
		Title     string    `json:"title"`
		Status    EnumValue `json:"status"`
		ErrorMsg  string    `json:"error_msg"`
		CostTime  int64     `json:"cost_time"`
		Ip        string    `json:"ip"`
		UserAgent string    `json:"user_agent"`
		CreatedAt int64     `json:"created_at"`
	}
	AdminOperationLogListRes {
		PageQueryResp
		Items []AdminOperationLogItem `json:"items"`
	}
	AdminLoginLogListReq {
		PageQueryReq
		Username  *string `form:"username,optional" validate:"omitempty,max=64"`
		Ip        *string `form:"ip,optional" validate:"omitempty,max=64"`
		Status    *int32  `form:"status,optional" validate:"omitempty,oneof=1 2"` // 结果 1成功 2失败
		StartTime *int64  `form:"start_time,optional" validate:"omitempty,gt=0"`
		EndTime   *int64  `form:"end_time,optional" validate:"omitempty,gt=0"`
	}
	AdminLoginLogItem {
		Id        int64     `json:"id"`
		AdminId   int64     `json:"admin_id"`
		Username  string    `json:"username"`
		Ip        string    `json:"ip"`
		UserAgent string    `json:"user_agent"`
		Status    EnumValue `json:"status"`
		Msg       string    `json:"msg"`
		CreatedAt int64     `json:"created_at"`
	}
	AdminLoginLogListRes {
		PageQueryResp
		Items []AdminLoginLogItem `json:"items"`
	}
)

@server (
	tags:       audit
	group:      audit
	prefix:     /v1/admin
	middleware: AdminAuthMiddleware,AdminRbacMiddleware,AdminAuditMiddleware
)
service admin-api {
	@doc (
		description: "操作审计日志"
		permission:  "admin:audit:list"
	)
	@handler ListOperationLogs
	get /operation-logs (AdminOperationLogListReq) returns (AdminOperationLogListRes)

	@doc (
		description: "登录审计日志"
		permission:  "admin:login-log:list"
	)
	@handler ListLoginLogs
	get /login-logs (AdminLoginLogListReq) returns (AdminLoginLogListRes)
}

