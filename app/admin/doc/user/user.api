syntax = "v1"

import "../base/base.api"

type (
	// CUserListReq C端用户列表
	CUserListReq {
		PageQueryReq
		Status   *int32  `form:"status,optional" validate:"omitempty,oneof=10 20 30"` // 状态 10正常 20禁用 30注销
		Username *string `form:"username,optional" validate:"omitempty,max=64"`
		Nickname *string `form:"nickname,optional" validate:"omitempty,max=64"`
	}
	CUserItem {
		UserId    int64     `json:"user_id"`
		Username  string    `json:"username"`
		Nickname  string    `json:"nickname"`
		Mobile    string    `json:"mobile"`
		Avatar    string    `json:"avatar"`
		Status    EnumValue `json:"status"`
		CreatedAt int64     `json:"created_at"`
	}
	CUserListRes {
		PageQueryResp
		Items []CUserItem `json:"items"`
	}
	CUserDetailReq {
		UserId int64 `form:"user_id,optional" validate:"required,gt=0"`
	}
	CUserDetailData {
		UserId    int64     `json:"user_id"`
		Username  string    `json:"username"`
		Nickname  string    `json:"nickname"`
		Mobile    string    `json:"mobile"`
		Avatar    string    `json:"avatar"`
		Status    EnumValue `json:"status"`
		Bio       string    `json:"bio"`
		Gender    EnumValue `json:"gender"`
		Email     string    `json:"email"`
		CreatedAt int64     `json:"created_at"`
		UpdatedAt int64     `json:"updated_at"`
	}
	CUserDetailRes {
		Detail CUserDetailData `json:"detail"`
	}
	// CUserStatusReq status 取 10 恢复 或 20 封禁
	CUserStatusReq {
		UserId int64 `json:"user_id,optional" validate:"required,gt=0"`
		Status int32 `json:"status,optional" validate:"required,oneof=10 20"`
	}
	CUserStatusRes {
		Status EnumValue `json:"status"` // 变更后状态
	}
)

@server (
	tags:       user
	group:      user
	prefix:     /v1/admin
	middleware: AdminAuthMiddleware,AdminRbacMiddleware,AdminAuditMiddleware
)
service admin-api {
	@doc (
		description: "C端用户列表"
		permission:  "admin:cuser:list"
	)
	@handler ListUsers
	get /users (CUserListReq) returns (CUserListRes)

	@doc (
		description: "C端用户详情"
		permission:  "admin:cuser:detail"
	)
	@handler GetUserDetail
	get /users/detail (CUserDetailReq) returns (CUserDetailRes)

	@doc (
		description: "C端用户封禁/恢复"
		permission:  "admin:cuser:ban"
	)
	@handler SetUserStatus
	post /users/status (CUserStatusReq) returns (CUserStatusRes)
}
