syntax = "v1"

import "../base/base.api"

type (
	AdminUserListReq {
		PageQueryReq
		Status   int32 `form:"status,optional"` // 0不限 10启用 20禁用
	}
	AdminUserItem {
		Id        int64     `json:"id"`
		Username  string    `json:"username"`
		Nickname  string    `json:"nickname"`
		Status    EnumValue `json:"status"`
		RoleCodes []string  `json:"role_codes"`
		CreatedAt int64     `json:"created_at"`
	}
	AdminUserListRes {
		PageQueryResp
		Items []AdminUserItem `json:"items"`
	}

	AdminUserDetailReq {
		Id int64 `form:"id"`
	}
	AdminUserDetailRes {
		Admin   AdminUserItem `json:"admin"`
		RoleIds []int64       `json:"role_ids"`
	}

	AdminUserCreateReq {
		Username string  `json:"username,optional" validate:"required"`
		Password string  `json:"password,optional" validate:"required,min=6"`
		Nickname string  `json:"nickname,optional"`
		RoleIds  []int64 `json:"role_ids,optional"`
	}
	AdminUserCreateRes {
		Id int64 `json:"id"`
	}

	AdminUserUpdateReq {
		Id       int64  `json:"id,optional" validate:"required,gt=0"`
		Nickname string `json:"nickname,optional" validate:"required"`
	}
	AdminUserUpdateRes {}

	// AdminUserStatusReq status 取 10(启用) 或 20(禁用)
	AdminUserStatusReq {
		Id     int64 `json:"id,optional" validate:"required,gt=0"`
		Status int32 `json:"status,optional" validate:"required"`
	}
	AdminUserStatusRes {}

	AdminUserResetPasswordReq {
		Id          int64  `json:"id,optional" validate:"required,gt=0"`
		NewPassword string `json:"new_password,optional" validate:"required,min=6"`
	}
	AdminUserResetPasswordRes {}

	// AdminUserSetRolesReq role_ids 空表示清空该管理员角色
	AdminUserSetRolesReq {
		AdminId int64   `json:"admin_id,optional" validate:"required,gt=0"`
		RoleIds []int64 `json:"role_ids,optional"`
	}
	AdminUserSetRolesRes {}
)

@server (
	tags:       adminuser
	group:      adminuser
	prefix:     /v1/admin
	middleware: AdminAuthMiddleware, AdminRbacMiddleware, AdminAuditMiddleware
)
service admin-api {
	@doc (
		description: "分页查询管理员列表"
		permission: "admin:user:list"
	)
	@handler ListAdmins
	get /admins (AdminUserListReq) returns (AdminUserListRes)

	@doc (
		description: "管理员详情 含角色ID"
		permission: "admin:user:detail"
	)
	@handler GetAdminDetail
	get /admins/detail (AdminUserDetailReq) returns (AdminUserDetailRes)

	@doc (
		description: "创建管理员"
		permission: "admin:user:create"
	)
	@handler CreateAdmin
	post /admins/create (AdminUserCreateReq) returns (AdminUserCreateRes)

	@doc (
		description: "修改管理员昵称"
		permission: "admin:user:update"
	)
	@handler UpdateAdmin
	post /admins/update (AdminUserUpdateReq) returns (AdminUserUpdateRes)

	@doc (
		description: "启用禁用管理员 禁用即踢下线"
		permission: "admin:user:status"
	)
	@handler SetAdminStatus
	post /admins/status (AdminUserStatusReq) returns (AdminUserStatusRes)

	@doc (
		description: "重置管理员密码 重置即踢下线"
		permission: "admin:user:reset-password"
	)
	@handler ResetAdminPassword
	post /admins/reset-password (AdminUserResetPasswordReq) returns (AdminUserResetPasswordRes)

	@doc (
		description: "覆盖式设管理员角色"
		permission: "admin:user:set-roles"
	)
	@handler SetAdminRoles
	post /admins/roles (AdminUserSetRolesReq) returns (AdminUserSetRolesRes)
}
