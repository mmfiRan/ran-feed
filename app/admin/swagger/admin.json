                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "content_id",
                      "content_type",
                      "status",
                      "visibility",
                      "author_id",
                      "title",
                      "like_count",
                      "favorite_count",
                      "comment_count",
                      "published_at",
                      "created_at"
