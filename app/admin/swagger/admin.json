                        "type": "integer"
                      },
                      "comment_count": {
                        "type": "integer"
                      },
                      "content_id": {
                        "type": "integer"
                      },
                      "content_type": {
                        "type": "integer"
                      },
                      "created_at": {
                        "description": "毫秒",
                        "type": "integer"
                      },
                      "favorite_count": {
                        "type": "integer"
                      },
                      "like_count": {
                        "type": "integer"
                      },
                      "published_at": {
                        "description": "毫秒 0 未发布",
