{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "pinyin_suggest": {
          "tokenizer": "pinyin_suggest_tk"
        }
      },
      "tokenizer": {
        "pinyin_suggest_tk": {
          "type": "pinyin",
          "keep_original": true,
          "keep_full_pinyin": true,
          "keep_joined_full_pinyin": true,
          "keep_first_letter": true,
          "lowercase": true,
          "remove_duplicated_term": true,
          "limit_first_letter_length": 16
        }
      }
    }
  },
  "mappings": {
    "_source": {
      "excludes": [
        "body",
        "title_suggest"
      ]
    },
    "properties": {
      "content_id": {
        "type": "keyword"
      },
      "title_suggest": {
        "type": "completion",
        "analyzer": "pinyin_suggest",
        "search_analyzer": "pinyin_suggest",
        "preserve_separators": false,
        "preserve_position_increments": false
      },
      "content_type": {
        "type": "byte"
      },
      "status": {
        "type": "byte"
      },
      "visibility": {
        "type": "byte"
      },
      "author_id": {
        "type": "keyword"
      },
      "title": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart"
      },
      "description": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart"
      },
      "body": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart"
      },
      "published_at": {
        "type": "date",
        "format": "epoch_millis"
      },
      "hot_score": {
        "type": "double"
      },
      "is_deleted": {
        "type": "byte"
      }
    }
  }
}